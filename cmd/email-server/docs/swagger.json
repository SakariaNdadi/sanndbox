{
	"swagger": "2.0",
	"info": {
		"description": "SMTP (:2525) \u0026 HTTP (:8081) Email Sanndbox with Static HTML Visibility Matrix and Attachment Threat Scanner.",
		"title": "Email Sanndbox API",
		"contact": {},
		"version": "1.0.0"
	},
	"basePath": "/",
	"paths": {
		"/": {
			"get": {
				"produces": ["text/html"],
				"summary": "Render Email Sanndbox Dashboard",
				"responses": {
					"200": {
						"description": "HTML Dashboard",
						"schema": {
							"type": "string"
						}
					}
				}
			}
		},
		"/api/v1/emails": {
			"get": {
				"produces": ["application/json"],
				"summary": "List evaluated emails",
				"parameters": [
					{
						"type": "string",
						"description": "Browser Tab Session ID",
						"name": "sessionId",
						"in": "query"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"schema": {
							"type": "array",
							"items": {
								"$ref": "#/definitions/main.EmailRecord"
							}
						}
					}
				}
			},
			"post": {
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"summary": "Submit email for evaluation",
				"parameters": [
					{
						"description": "Email Submission Payload",
						"name": "payload",
						"in": "body",
						"required": true,
						"schema": {
							"$ref": "#/definitions/main.EmailSubmissionRequest"
						}
					}
				],
				"responses": {
					"201": {
						"description": "Created",
						"schema": {
							"$ref": "#/definitions/main.EmailRecord"
						}
					}
				}
			}
		},
		"/api/v1/emails/clear": {
			"post": {
				"summary": "Clear session-scoped email cache",
				"parameters": [
					{
						"type": "string",
						"description": "Browser Tab Session ID",
						"name": "sessionId",
						"in": "query",
						"required": true
					}
				],
				"responses": {
					"204": {
						"description": "Cleared",
						"schema": {
							"type": "string"
						}
					}
				}
			}
		},
		"/docs": {
			"get": {
				"produces": ["text/html"],
				"summary": "Interactive OpenAPI 3.0 Documentation",
				"responses": {
					"200": {
						"description": "Swagger UI HTML",
						"schema": {
							"type": "string"
						}
					}
				}
			}
		},
		"/events": {
			"get": {
				"produces": ["text/event-stream"],
				"summary": "Real-time HTMX SSE stream",
				"parameters": [
					{
						"type": "string",
						"description": "Browser Tab Session ID",
						"name": "sessionId",
						"in": "query"
					}
				],
				"responses": {
					"200": {
						"description": "SSE Stream",
						"schema": {
							"type": "string"
						}
					}
				}
			}
		}
	},
	"definitions": {
		"main.AttachmentPayload": {
			"type": "object",
			"properties": {
				"base64Data": {
					"type": "string"
				},
				"contentType": {
					"type": "string"
				},
				"filename": {
					"type": "string"
				}
			}
		},
		"main.EmailRecord": {
			"type": "object",
			"properties": {
				"attachments": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/main.AttachmentPayload"
					}
				},
				"htmlBody": {
					"type": "string"
				},
				"id": {
					"type": "string"
				},
				"recipients": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"report": {
					"$ref": "#/definitions/main.EvaluationReport"
				},
				"sender": {
					"type": "string"
				},
				"sessionId": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"subject": {
					"type": "string"
				},
				"timestamp": {
					"type": "string"
				}
			}
		},
		"main.EmailSubmissionRequest": {
			"type": "object",
			"properties": {
				"attachments": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/main.AttachmentPayload"
					}
				},
				"htmlBody": {
					"type": "string"
				},
				"recipients": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"sender": {
					"type": "string"
				},
				"sessionId": {
					"type": "string"
				},
				"subject": {
					"type": "string"
				}
			}
		},
		"main.EvaluationCriterion": {
			"type": "object",
			"properties": {
				"category": {
					"type": "string"
				},
				"details": {
					"type": "string"
				},
				"status": {
					"$ref": "#/definitions/main.EvaluationStatus"
				},
				"target": {
					"type": "string"
				}
			}
		},
		"main.EvaluationReport": {
			"type": "object",
			"properties": {
				"criteria": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/main.EvaluationCriterion"
					}
				},
				"overallStatus": {
					"$ref": "#/definitions/main.EvaluationStatus"
				}
			}
		},
		"main.EvaluationStatus": {
			"type": "string",
			"enum": ["PASS", "WARN", "FAIL"],
			"x-enum-varnames": ["StatusPass", "StatusWarn", "StatusFail"]
		}
	}
}
