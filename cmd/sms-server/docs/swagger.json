{
    "swagger": "2.0",
    "info": {
        "description": "HTTP (:8082) SMS Sanndbox with GSM-7 and UCS-2 Encoding and Segmentation Evaluation Engine.",
        "title": "SMS Sanndbox API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "produces": [
                    "text/html"
                ],
                "summary": "Render SMS Sanndbox Dashboard",
                "responses": {
                    "200": {
                        "description": "HTML Dashboard",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/sms": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "List evaluated SMS records",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Browser Tab Session ID",
                        "name": "sessionId",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.SMSRecord"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Submit SMS for GSM-7/UCS-2 evaluation",
                "parameters": [
                    {
                        "description": "SMS Submission Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.SMSSubmissionRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.SMSRecord"
                        }
                    }
                }
            }
        },
        "/api/v1/sms/clear": {
            "post": {
                "summary": "Clear cached SMS messages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Browser Tab Session ID",
                        "name": "sessionId",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Delete every message on this channel",
                        "name": "all",
                        "in": "query"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Cleared",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/docs": {
            "get": {
                "produces": [
                    "text/html"
                ],
                "summary": "Interactive OpenAPI 3.0 Documentation",
                "responses": {
                    "200": {
                        "description": "Swagger UI HTML",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/events": {
            "get": {
                "produces": [
                    "text/event-stream"
                ],
                "summary": "Real-time HTMX SSE stream",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Browser Tab Session ID",
                        "name": "sessionId",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE Stream",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.EvaluationCriterion": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "details": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/main.EvaluationStatus"
                },
                "target": {
                    "type": "string"
                }
            }
        },
        "main.EvaluationStatus": {
            "type": "string",
            "enum": [
                "PASS",
                "WARN",
                "FAIL"
            ],
            "x-enum-varnames": [
                "StatusPass",
                "StatusWarn",
                "StatusFail"
            ]
        },
        "main.SMSEvaluationReport": {
            "type": "object",
            "properties": {
                "criteria": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.EvaluationCriterion"
                    }
                },
                "encoding": {
                    "type": "string"
                },
                "overallStatus": {
                    "$ref": "#/definitions/main.EvaluationStatus"
                },
                "perSegmentLimit": {
                    "type": "integer"
                },
                "segmentCount": {
                    "type": "integer"
                },
                "totalUnits": {
                    "type": "integer"
                }
            }
        },
        "main.SMSRecord": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "recipient": {
                    "type": "string"
                },
                "report": {
                    "$ref": "#/definitions/main.SMSEvaluationReport"
                },
                "sender": {
                    "type": "string"
                },
                "sessionId": {
                    "type": "string"
                },
                "source": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "main.SMSSubmissionRequest": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "recipient": {
                    "type": "string"
                },
                "sender": {
                    "type": "string"
                },
                "sessionId": {
                    "type": "string"
                }
            }
        }
    }
}